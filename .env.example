# ==============================================================================
# CLOUDPULSE AI — ENVIRONMENT CONFIGURATION
# ==============================================================================
# CloudPulse AI works out-of-the-box in full demo mode without any required keys.
# To connect to external production backends, configure the variables below.
# Copy this file to `.env.local` to enable your custom credentials.

# 1. Google Maps Platform JavaScript API Key (Optional)
# Leave blank to use CloudPulse Cartographic Radar.
# When provided, activates real Google Maps with satellite, street labels, and live places search.
VITE_GOOGLE_MAPS_API_KEY=

# 2. Supabase Cloud Realtime Backend (Optional)
# Leave blank to use local near real-time synchronization (LocalStorage + BroadcastChannel).
# When provided, syncs incidents and duplicate merges across different machines/devices in near real-time.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. Live Neural AI Provider (Optional)
# Leave blank to run in honest "AI MODE: DEMO — DETERMINISTIC" mode.
# When provided, dispatches live inference requests to the configured model.
VITE_AI_PROVIDER_API_KEY=
VITE_AI_PROVIDER_MODEL=gemini-1.5-flash
